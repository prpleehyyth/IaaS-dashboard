# ==============================================================================
# CloudForge IaaS — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operation Mode
# ------------------------------------------------------------------------------
# Set to 'DEVELOPMENT' for live lab/testing with clean state & real hypervisor drivers.
# Set to 'SIMULATOR' for mock telemetry & guest console.
# Set to 'PRODUCTION' to connect to real Proxmox VE & VMware vCenter hardware in production.
HYPERVISOR_MODE=DEVELOPMENT

# ------------------------------------------------------------------------------
# 2. Database & Cache Credentials
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=iaas_db
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@postgres:5432/iaas_db?sslmode=disable

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_PORT=6379

JWT_SECRET=super-secret-iaas-private-cloud-key-32chars-min
PORT=8080

# ------------------------------------------------------------------------------
# 3. Proxmox VE Cluster Configuration (Cluster 1 - 3 Nodes)
# ------------------------------------------------------------------------------
# IP / Hostname & Port Proxmox VE (default port: 8006)
PROXMOX_ENDPOINT=https://192.168.10.100:8006
PROXMOX_NODE_1=pve-node-01
PROXMOX_NODE_2=pve-node-02
PROXMOX_NODE_3=pve-node-03

# Autentikasi API Token Proxmox
# Dibuat di Proxmox GUI: Datacenter -> Permissions -> API Tokens
PROXMOX_TOKEN_ID=root@pam!iaas_controller
PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PROXMOX_INSECURE_SSL=true

# ------------------------------------------------------------------------------
# 4. VMware vSphere / vCenter Configuration (Cluster 1, 2, 3 - 9 Nodes)
# ------------------------------------------------------------------------------
# vCenter Server Appliance (VCSA) SDK Endpoint (default port: 443 /sdk)
VCENTER_HOST=192.168.10.50
VCENTER_USER=administrator@vsphere.local
VCENTER_PASSWORD=YourVcenterPassword123!
VCENTER_INSECURE_SSL=true

# Nama Klaster VMware yang ada di dalam vCenter:
VCENTER_DATACENTER=Datacenter-01
VCENTER_CLUSTER_1=vmware-prod-01
VCENTER_CLUSTER_2=vmware-prod-02
VCENTER_CLUSTER_3=vmware-prod-03
